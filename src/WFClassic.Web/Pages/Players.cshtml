@page
@model WFClassic.Web.Pages.PlayersModel

@{
    ViewData["Title"] = "Log in";

}

<div class="container">
    <table  class="table table-striped table-bordered nowrap" width="100%"  cellspacing="0">
        <thead>
            <tr>
                <th>User Name</th>
                <th>Joined On</th>
                <th>Last Login Date</th>
                <th>Status</th>
                <th>View</th>
            </tr>
        </thead>
        @foreach (var row in Model.Players)
        {
            <tr>
                <td>
                    @row.UserName
                </td>
                <td>
                    @row.JoinedOnDate
                </td>
                <td>
                    @row.LastLoginDate
                </td>
                <td>
                    @row.IsCurrentlyOnline
                </td>
                <td>
                </td>

            </tr>
        }

    </table>

</div>
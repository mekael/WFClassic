@page
@model WFClassic.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Home page";
}
@using Microsoft.AspNetCore.Http.Features
@using Microsoft.Extensions.Configuration
@using WFClassic.Web.Logic.Shared

@inject ServerConfiguration   configuration
@{
    string clientVersion = configuration.BuildLabel;
    string serverVersion = configuration.ServerVersion;
    bool automaticCreationOfLoginViaClient = configuration.AutomaticallyCreateAccountUponInitialLogin;
    var serverIp = this.HttpContext.Features.Get<IHttpConnectionFeature>()?.LocalIpAddress.ToString();
}

@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Server Version: @serverVersion</p>
    <p>Supported Client Version:  @clientVersion </p>
    <p>Automatic creation of account enabled:  @automaticCreationOfLoginViaClient </p>
    <p>Server Ip Address: @serverIp </p>
</div>

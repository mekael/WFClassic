<aside class="main-sidebar sidebar-dark-primary elevation-4">
    <a href="~/Home" class="brand-link">
        <span class="brand-text font-weight-light">Warframe Classic</span>
    </a>
    <div class="sidebar">
        @if (User.Identity.IsAuthenticated)
        {
            <div class="user-panel mt-3 pb-3 mb-3 d-flex">
                <div class="info">
                    <a href="/Identity/Account/Manage" class="d-block">Hi, @User.Identity.Name </a>
                </div>
            </div>
        }

        <nav class="mt-2">
            <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                <li class="nav-item ">
                    <a asp-page="Index" class="nav-link">
                        <i class="nav-icon fas fa-home"></i>
                        <p> Home </p>
                    </a>
                </li>
                <li class="nav-item ">
                    <a asp-page="Players" class="nav-link">
                        <i class="nav-icon fas fa-user"></i>
                        <p>  Player Listing </p>
                    </a>
                </li>
                <li class="nav-item ">
                    <a asp-page="WarframeItems" class="nav-link">
                        <i class="nav-icon fas fa-gear"></i>
                        <p> Warframe Item Listing </p>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
</aside>